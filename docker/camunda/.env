DB_NAME=process-engine
DB_PORT=5432
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://camunda_postgres:5432/process-engine
DB_USERNAME=camunda
DB_PASSWORD=camunda
WAIT_FOR=camunda_postgres:5432
WAIT_FOR_TIMEOUT=60

# Camunda tuned engine configuration via Spring Boot environment variables
# Map settings from READ_FOR_CAMUNDA_TUNING.md to environment variables using Spring Boot relaxed binding.

# Enable job execution
CAMUNDA_BPM_JOB_EXECUTION_ENABLED=true

# Job acquisition groups: define two acquisitions as a list
# SPRING/CAMUNDA relaxed binding for lists: CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_NAME, etc.

CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_NAME=default
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_MAX_JOBS_PER_ACQUISITION=10
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_QUEUE_SIZE=100
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_WAIT_TIME_IN_MILLIS=1000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_LOCK_TIME_IN_MILLIS=300000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_ACQUIRE_BY_DUE_DATE=false

# Alternative keys (some starters/tools map differently); kept for compatibility
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_MAXJOBS_PERACQUISITION=10
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_QUEUESIZE=100
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_WAITTIMEINMILLIS=1000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_LOCKTIMEINMILLIS=300000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_0_ACQUIREBYDUEDATE=false

CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_NAME=background
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_MAX_JOBS_PER_ACQUISITION=5
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_QUEUE_SIZE=50
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_WAIT_TIME_IN_MILLIS=5000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_LOCK_TIME_IN_MILLIS=600000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_ACQUIRE_BY_DUE_DATE=false

# Alternative keys for acquisition 1
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_MAXJOBS_PERACQUISITION=5
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_QUEUESIZE=50
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_WAITTIMEINMILLIS=5000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_LOCKTIMEINMILLIS=600000
CAMUNDA_BPM_JOB_EXECUTION_ACQUISITION_1_ACQUIREBYDUEDATE=false

# Disable acquireByDueDate at the engine level if present
CAMUNDA_BPM_JOB_EXECUTION_ACQUIRE_BY_DUE_DATE=false

# Alternative engine-level key
CAMUNDA_BPM_JOB_EXECUTION_ACQUIREBYDUEDATE=false

# Database connection pool tuning
CAMUNDA_BPM_DATABASE_HIKARI_MAXIMUMPOOLSIZE=50
CAMUNDA_BPM_DATABASE_HIKARI_MINIMUMIDLE=5
CAMUNDA_BPM_DATABASE_HIKARI_CONNECTIONTIMEOUT=30000
CAMUNDA_BPM_DATABASE_HIKARI_IDLETIMEOUT=600000
CAMUNDA_BPM_DATABASE_HIKARI_MAXLIFETIME=1800000

# History level (activity or audit recommended instead of full)
CAMUNDA_BPM_HISTORY_LEVEL=none

# History cleanup settings (async cleanup, removalTime based)
CAMUNDA_BPM_HISTORY_CLEANUP_BATCH_WINDOW_START_TIME=02:00
CAMUNDA_BPM_HISTORY_CLEANUP_BATCH_WINDOW_END_TIME=04:00
CAMUNDA_BPM_HISTORY_CLEANUP_STRATEGY=removalTimeBased

# Alternative cleanup keys
CAMUNDA_BPM_HISTORY_CLEANUP_BATCHWINDOW_STARTTIME=02:00
CAMUNDA_BPM_HISTORY_CLEANUP_BATCHWINDOW_ENDTIME=04:00

# Optional: tune history cleanup batch size / other properties if available
# CAMUNDA_BPM_HISTORYCLEANUP_BATCHSIZE=100

# Note: variable names follow Spring Boot relaxed binding rules but
# some property names are specific to the Camunda Spring Boot starter.
# If a property is not picked up, inspect the Camunda starter docs for exact names.